# Copy to .env for local --check runs. Never commit .env.
WORKIVA_CLIENT_ID=
WORKIVA_CLIENT_SECRET=

# Optional
WORKIVA_IAM_BASE_URL=https://api.app.wdesk.com
WORKIVA_PLATFORM_BASE_URL=https://api.app.wdesk.com
WORKIVA_API_VERSION=2026-01-01
WORKIVA_SCOPES=
# Needed for user lookup tools (list_users, find_user_id)
WORKIVA_ORG_ID=
WORKIVA_WORKSPACE_ID=
# Set to true to disable all create/edit/delete/publish tools
WORKIVA_READ_ONLY=false
